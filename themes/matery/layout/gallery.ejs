<%- partial('_partial/bg-cover') %>
<style>
    #sma {
        bottom: 150px;
    }
    .comment-scroll {
        bottom: 83px;
    }
    @media only screen and (max-width: 601px) {
        #switchspring {
            bottom: 178px!important;
        }
    }
    #switchspring {
        bottom: 223px;
    }
</style>
<!-- 增加相册显示的特效样式 -->
<style>
    /* .bg-cover {
        background-images: url("/medias/banner/gallerybg.jpg")!important;
    } */
    .bg-cover::before {
        background-image: url(https://cdn.jsdelivr.net/gh/moezx/cdn@3.1.9/img/Sakura/images/grid.png);
    }
    @media only screen and (max-width: 600px) {
        .about-cover {
            height: 64vh;
        }
    }
    .photo {
        padding: 0 16px 32px!important;
        position: relative;
        width: 100%;
        transition: transform .4s ease, box-shadow .4s ease;
    }
    .biaotiss {
        padding: 12px 14px 16px;
        color: #444;
        text-align: center;
        line-height: 1.6;
    }
    .img-item {
        padding: .2rem;
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        transition: all .4s cubic-bezier(.63,.15,.03,1.12);
        margin-bottom: 12px;
        overflow: hidden;
    }
    .img-item img {
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    .img-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.18);
    }
    .img-item:hover img {
        transform: scale(1.04);
    }
    .photo:hover {
        transform: translateY(-4px);
    }
    .text_des{
        position: absolute;
        width: 92%;
        height: 100%;
        top: 0;
        color: #000;
        overflow: hidden;
    }
    .text_des h3{
        margin: 5px 0 8px 0px;
        right: 40px;
        font-size: 1.5rem;
        font-weight: bold;
        line-height: 1.7rem;
        position: absolute;
        top: 10%;
        font-style: italic;
        text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.3);
        /*transform: translateX(200px);  */
    }
    .text_des p{
        left: 15px;
        position: absolute;
        top: 50%;
    /*    transform: translateX(-200px);
        transition-delay: 0.2s;    */
    }
    .my-gallery .photo img {
        border-radius: 14px;
        width: 100%;
        height: 230px;
        object-fit: cover;
        display: block;
    }
    .card .card-content {
        padding: 24px 24px 24px 24px;
    }
    .miaoshus {
        padding: 20px;
        border: 1px dashed #e6e6e6;
        color: #969696;
        position: relative;
        display: inline-block;
        width: 95%;
        background: #fbfbfb50;
        border-radius: 10px;
        font-size: 16px;
        margin: 12px auto;
    }
    body.dark .miaoshus {
        background: 0 0;
        border: 1px dashed #888;
    }
    .img-item {
            transition: all 0.4s ease-out;
        }
        .img-item a img{
            opacity: 1;
            transition: all 0.4s ease-out;
        }
        .img-item a:hover img{
            opacity: 0.8;
        }
        .biaotiss {
            font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
        }
        .biaotiss .album-name {
            font-size: 18px;
            font-weight: 700;
            color: #333;
            margin-bottom: 4px;
        }
        .biaotiss .album-date {
            font-size: 14px;
            color: #888;
        }
        .miaoshus .title {
        font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    }
    .my-gallery .photo[data-spmid="./特辑-十年一梦-回顾湖人2019-2020赛季夺冠之旅"],
    .my-gallery .photo[data-spmid="./盘点-詹姆斯总决赛数据排名"],
    .my-gallery .photo[data-spmid="./知名摄影师最爱的24张科比图集"]
        {
            display: none;
        }
    .my-gallery {
        margin: 3.5rem auto 1.5rem;
        max-width: 1200px;
        padding: 0 10px;
    }
    .my-gallery-grid {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -16px;
    }
    .my-gallery-grid .photo {
        box-sizing: border-box;
        width: 33.3333%;
    }
    @media only screen and (max-width: 992px) {
        .my-gallery-grid .photo {
            width: 50%;
        }
    }
    @media only screen and (max-width: 600px) {
        .my-gallery-grid .photo {
            width: 100%;
        }
    }
     /*大屏幕下(桌面类)的样式*/
    @media only screen and (min-width: 993px) {
        .text_des h3{
            transform: translateX(200px);
        }
        .text_des p{
            transform: translateX(-200px);
            transition-delay: 0.2s;
        }
        .animate-text {
            opacity: 0;
            transition: all 0.6s ease-in-out;
        }
    }
    /*小屏幕下(桌面类)的样式*/
    @media only screen and (max-width: 500px) {
        .my-gallery .photo img {
            height: 186px;
        }
    }

</style>
<main class="content">
    <div class="container chip-container">
        <div class="card">
            <div class="card-content">
                <div class="tag-title center-align">
                    <div class="miaoshus">
                        <div class="title center-align">“ <%- theme.gallery.title %> ”</div>
                        “ 日子过的好快，还好我都记录下来了。 ”
                    </div>
                </div>
                <div class="my-gallery">
                    <div class="my-gallery-grid">
                    <% if (site.data && site.data.gallery) { %>
                        <% 
                            var allGallery = site.data.gallery;
                            var isVideoPage = page.type === 'video';
                            var gallery = allGallery.filter(function(item) {
                                var isVideoGallery = item.isVideoGallery === true;
                                return isVideoPage ? isVideoGallery : !isVideoGallery;
                            });
                        %>
                        <% for (var i = 0, len = gallery.length; i < len; i++) { %>
                            <% var photo = gallery[i]; %>
                            <% if (photo.cover){ %>
                            <div class="photo col s12 m6 l4" data-spmid="./<%- photo.url_name %>">
                                <div class="img-item">
                                    <a href="./<%- photo.url_name %>">
                                        <img src="/medias/loading.svg" data-src="<%- photo.cover %>" class="responsive-img" alt="img"+<%- i %> style="width: 100%; height: auto; object-fit: cover;" />
                                        <div class="biaotiss">
                                            <div class="album-name">“ <%- photo.name %> ”</div>
                                            <div class="album-date">“ <%- photo.date %> ”</div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <% } %>
                        <% } %>
                    <% } %>
                </div>
            </div>
            </div>
        </div>

    </div>

    <script>
        start()
            $(window).on('scroll', function(){
             start();
        })
        function start(){
              //.not('[data-isLoaded]')选中已加载的图片不需要重新加载
            $('.container img').not('[data-isLoaded]').each(function(){
                var $node = $(this)
                if( isShow($node) ){
                    loadImg($node);
                }
            });
         }
        //判断一个元素是不是出现在窗口(视野)
        function isShow($node){
            return $node.offset().top <= $(window).height() + $(window).scrollTop();
        }
        //加载图片
        function loadImg($img){
        //.attr(值)
        //.attr(属性名称,值)
            $img.attr('src', $img.attr('data-src')); //把data-src的值 赋值给src
            $img.attr('data-isLoaded', 1);//已加载的图片做标记
        }
    </script>
</main>
